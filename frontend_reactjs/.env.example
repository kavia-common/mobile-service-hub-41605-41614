# Frontend (CRA) environment variables
# Copy to your own environment configuration as needed.

# Existing:
# REACT_APP_API_BASE=
# REACT_APP_BACKEND_URL=
# REACT_APP_FRONTEND_URL=
# REACT_APP_WS_URL=
# REACT_APP_NODE_ENV=

# Required for geolocation-enabled interactive map (Google Maps JS + Directions):
REACT_APP_GOOGLE_MAPS_API_KEY=
